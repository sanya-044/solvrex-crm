generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(30)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]

  @@map("roles")
}

model User {
  id              BigInt        @id @default(autoincrement())
  fullName        String        @map("full_name") @db.VarChar(100)
  email           String        @unique @db.VarChar(255)
  passwordHash    String        @map("password_hash")
  roleId          BigInt        @map("role_id")
  isActive        Boolean       @default(true) @map("is_active")
  phone           String?       @db.VarChar(20)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions        UserSession[]
  passwordResetTokens PasswordResetToken[]
  role            Role          @relation(fields: [roleId], references: [id], onUpdate: NoAction, map: "fk_users_role")

  @@index([roleId], map: "idx_users_role_id")
  @@map("users")
}

model UserSession {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sessions_user")

  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([userId], map: "idx_sessions_user_id")
  @@map("user_sessions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  email     String    @db.VarChar(255)
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_tokens_user")

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@index([expiresAt], map: "idx_password_reset_tokens_expires_at")
  @@map("password_reset_tokens")
}

enum CallStatus {
  INITIATING
  RINGING
  CONNECTED
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
}

enum FollowUpStatus {
  PENDING
  DONE
}

model Call {
  id              String     @id @default(cuid())
  leadId          String     @map("lead_id")
  leadName        String     @map("lead_name")
  leadPhone       String     @map("lead_phone")
  callerId        String     @map("caller_id")
  callerName      String     @map("caller_name")
  callerPhone     String     @map("caller_phone")
  exotelCallSid   String?    @unique @map("exotel_call_sid")
  status          CallStatus @default(INITIATING)
  outcome         String?
  notes           String?
  durationSeconds Int        @default(0) @map("duration_seconds")
  recordingUrl    String?    @map("recording_url")
  answeredAt      DateTime?  @map("answered_at") @db.Timestamptz(6)
  endedAt         DateTime?  @map("ended_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  followUps       FollowUp[]
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId], map: "idx_calls_lead_id")
  @@index([callerId], map: "idx_calls_caller_id")
  @@index([status], map: "idx_calls_status")
  @@map("calls")
}

model FollowUp {
  id             String         @id @default(cuid())
  callId         String?        @map("call_id")
  leadId         String         @map("lead_id")
  leadName       String         @map("lead_name")
  assignedToId   String         @map("assigned_to_id")
  assignedToName String         @map("assigned_to_name")
  dueAt          DateTime       @map("due_at") @db.Timestamptz(6)
  priority       String         @default("Medium") @db.VarChar(10)
  notes          String?
  status         FollowUpStatus @default(PENDING)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  call           Call?          @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, dueAt], map: "idx_followups_assignee_due")
  @@map("follow_ups")
}

model Lead {
  id                 String     @id @default(cuid())
  name               String     @map("name") @db.VarChar(255)
  contactPerson      String     @map("contact_person") @db.VarChar(100)
  phone              String     @map("phone") @db.VarChar(50)
  email              String     @default("") @map("email") @db.VarChar(255)
  city               String     @default("") @map("city") @db.VarChar(100)
  category           String     @default("") @map("category") @db.VarChar(100)
  googleRating       Float      @default(0.0) @map("google_rating")
  googleReviewsCount Int        @default(0) @map("google_reviews_count")
  websiteUrl         String     @default("") @map("website_url") @db.VarChar(500)
  instagramUrl       String     @default("") @map("instagram_url") @db.VarChar(500)
  source             String     @default("Google Maps") @map("source") @db.VarChar(100)
  assignedCaller     String     @default("Priya Sharma") @map("assigned_caller") @db.VarChar(100)
  status             String     @default("New") @map("status") @db.VarChar(50)
  pipeline           String     @default("Lead") @map("pipeline") @db.VarChar(50)
  priority           String     @default("Medium") @map("priority") @db.VarChar(20)
  notes              String?    @map("notes")
  followUpDate       String     @default("") @map("follow_up_date") @db.VarChar(50)
  followUpTime       String?    @map("follow_up_time") @db.VarChar(20)
  lastCallOutcome    String?    @map("last_call_outcome") @db.VarChar(50)
  totalCalls         Int        @default(0) @map("total_calls")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  calls              Call[]

  @@index([assignedCaller], map: "idx_leads_assigned_caller")
  @@index([pipeline], map: "idx_leads_pipeline")
  @@map("leads")
}